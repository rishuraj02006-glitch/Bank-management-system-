  const token = localStorage.getItem('token');

  const api = axios.create({
    baseURL: 'http://localhost:8080/api',
    headers: { Authorization: `Bearer ${token}` }
  });

  const fetchData = async () => {
    try {
      const bal = await api.get('/accounts/balance');
      const txns = await api.get('/transactions/mini-statement?limit=10');
      setBalance(bal.data);
      setTransactions(txns.data);
    } catch (err) {
      if (err.response?.status === 401) {
        localStorage.removeItem('token');
        navigate('/');
      }
    }
  };

  useEffect(() => {
    if (!token) navigate('/');
    else fetchData();
  }, []);

  const handleDeposit = async () => {
    await api.post('/accounts/deposit', { amount: parseFloat(amount) });
    setShowDeposit(false); setAmount(''); fetchData();
  };

  const handleWithdraw = async () => {
    await api.post('/accounts/withdraw', { amount: parseFloat(amount) });
    setShowWithdraw(false); setAmount(''); fetchData();
  };

  const handleTransfer = async () => {
    await api.post('/accounts/transfer', { toAccount: parseInt(toAccount), amount: parseFloat(amount) });
    setShowTransfer(false); setAmount(''); setToAccount(''); fetchData();
  };

  const logout = () => {
    localStorage.removeItem('token');
    navigate('/');
  };

  return (
    <Container className="mt-4">
      <Row className="mb-3">
        <Col><h2>Bank Dashboard</h2></Col>
